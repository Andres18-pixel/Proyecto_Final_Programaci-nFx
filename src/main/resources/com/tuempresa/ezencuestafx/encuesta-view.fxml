<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="680.0" prefWidth="1050.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuempresa.ezencuestafx.controller.EncuestaController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #1E293B;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
            </padding>
            <children>
                <Label text="Constructor de Encuestas" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Separator orientation="VERTICAL" />
                <Label text="Título:" textFill="#CBD5E1" />
                <TextField fx:id="txtTituloEncuesta" prefWidth="350.0" promptText="Ej. Encuesta de Satisfacción" text="Nueva Encuesta" />
            </children>
        </HBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.42" BorderPane.alignment="CENTER">
            <items>
                <!-- PANEL IZQUIERDO: CONFIGURACIÓN DE PREGUNTA -->
                <VBox spacing="12.0" style="-fx-background-color: #F8FAFC;">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Label text="1. Configurar Nueva Pregunta" textFill="#0F172A">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>
                        <Separator />

                        <Label text="Enunciado de la pregunta:" />
                        <TextField fx:id="txtEnunciado" onAction="#handleAgregarPregunta" promptText="Escribe aquí tu pregunta..." />

                        <Label text="Tipo de respuesta:" />
                        <ComboBox fx:id="cmbTipoPregunta" maxWidth="1.7976931348623157E308" />

                        <CheckBox fx:id="chkObligatoria" mnemonicParsing="false" text="Pregunta obligatoria (No permitir dejar en blanco)" />

                        <!-- CONTENEDOR DINÁMICO PARA OPCIONES DE SELECCIÓN -->
                        <VBox fx:id="boxOpcionesConfig" managed="false" spacing="8.0" style="-fx-background-color: #E2E8F0; -fx-background-radius: 6;" visible="false">
                            <padding>
                                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                            </padding>
                            <children>
                                <Label text="Opciones de respuesta:">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <HBox spacing="8.0">
                                    <children>
                                        <TextField fx:id="txtNuevaOpcion" onAction="#handleAgregarOpcion" promptText="Texto de la opción..." HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnAgregarOpcion" mnemonicParsing="false" onAction="#handleAgregarOpcion" style="-fx-background-color: #334155; -fx-text-fill: white;" text="+ Añadir" />
                                    </children>
                                </HBox>
                                <ListView fx:id="lstOpciones" prefHeight="130.0" />
                                <Button fx:id="btnEliminarOpcion" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleEliminarOpcion" text="Quitar opción seleccionada" />
                            </children>
                        </VBox>

                        <Button fx:id="btnAgregarPregunta" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleAgregarPregunta" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold;" text="Agregar Pregunta a la Encuesta">
                            <padding>
                                <Insets bottom="10.0" top="10.0" />
                            </padding>
                        </Button>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleExportarWord" style="-fx-background-color: #7C3AED; -fx-text-fill: white; -fx-font-weight: bold;" text="Exportar a Word (.docx)">
                            <padding>
                                <Insets bottom="10.0" top="10.0" />
                            </padding>
                        </Button>
                    </children>
                </VBox>

                <!-- PANEL DERECHO: VISTA PREVIA INTERACTIVA -->
                <VBox spacing="12.0" style="-fx-background-color: #FFFFFF;">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label fx:id="lblPreviewTitulo" text="Nueva Encuesta" textFill="#0F172A" HBox.hgrow="ALWAYS">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                <Button fx:id="btnValidarEncuesta" mnemonicParsing="false" onAction="#handleValidarRespuestas" style="-fx-background-color: #16A34A; -fx-text-fill: white; -fx-font-weight: bold;" text="Probar Validación" />
                            </children>
                        </HBox>
                        <Separator />

                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="contenedorPreguntasPreview" spacing="15.0">
                                    <padding>
                                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>
