<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="raiz" styleClass="fondo-auth" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuempresa.ezencuestafx.controller.SignupController">
    <children>
        <!-- Fondo decorativo animado -->
        <Pane mouseTransparent="true">
            <children>
                <Circle fx:id="burbuja1" centerX="140.0" centerY="140.0" radius="150.0" styleClass="burbuja" />
                <Circle fx:id="burbuja2" centerX="860.0" centerY="580.0" radius="200.0" styleClass="burbuja" />
                <Circle fx:id="burbuja3" centerX="820.0" centerY="110.0" radius="70.0" styleClass="burbuja-clara" />
                <Circle fx:id="burbuja4" centerX="170.0" centerY="590.0" radius="45.0" styleClass="burbuja-clara" />
            </children>
        </Pane>

        <!-- Tarjeta de registro -->
        <VBox fx:id="tarjeta" maxHeight="-Infinity" maxWidth="460.0" spacing="8.0" styleClass="tarjeta">
            <children>
                <Label styleClass="titulo-app" text="Crear cuenta" />
                <Label styleClass="subtitulo" text="Tus preguntas quedarán guardadas para que las reutilices en otras encuestas." wrapText="true" />

                <Label styleClass="etiqueta" text="Nombre completo">
                    <VBox.margin>
                        <Insets top="6.0" />
                    </VBox.margin>
                </Label>
                <TextField fx:id="txtNombre" promptText="Ej. Andrés Centeno" styleClass="campo" />

                <Label styleClass="etiqueta" text="Correo" />
                <TextField fx:id="txtCorreo" promptText="Ej. nombre@uamv.edu.ni" styleClass="campo" />

                <Label styleClass="etiqueta" text="Usuario" />
                <TextField fx:id="txtUsuario" promptText="Letras, números, punto o guion bajo" styleClass="campo" />

                <HBox spacing="10.0">
                    <children>
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="etiqueta" text="Contraseña" />
                                <PasswordField fx:id="txtContrasena" promptText="Mínimo 6 caracteres" styleClass="campo" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="etiqueta" text="Confirmar contraseña" />
                                <PasswordField fx:id="txtConfirmar" onAction="#handleRegistrar" promptText="Repite la contraseña" styleClass="campo" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Label styleClass="etiqueta" text="Soy...">
                    <VBox.margin>
                        <Insets top="4.0" />
                    </VBox.margin>
                </Label>
                <HBox spacing="10.0">
                    <children>
                        <ToggleButton fx:id="tglDocente" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="opcion-rol" text="Docente" HBox.hgrow="ALWAYS" />
                        <ToggleButton fx:id="tglEstudiante" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="opcion-rol" text="Estudiante de investigación" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <Label fx:id="lblMensaje" managed="false" styleClass="mensaje-error" visible="false" wrapText="true" />

                <Button fx:id="btnRegistrar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleRegistrar" styleClass="boton-primario" text="Crear mi cuenta">
                    <VBox.margin>
                        <Insets top="6.0" />
                    </VBox.margin>
                </Button>

                <HBox alignment="CENTER" spacing="4.0">
                    <children>
                        <Label styleClass="subtitulo" text="¿Ya tienes cuenta?" />
                        <Hyperlink onAction="#handleIrALogin" styleClass="enlace" text="Inicia sesión" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
