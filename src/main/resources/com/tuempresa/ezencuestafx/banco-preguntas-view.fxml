<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="raiz" prefHeight="580.0" prefWidth="940.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuempresa.ezencuestafx.controller.BancoPreguntasController">
    <top>
        <VBox spacing="10.0" style="-fx-background-color: #1E293B;">
            <padding>
                <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
            </padding>
            <children>
                <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Banco de preguntas" />
                <Label fx:id="lblDescripcion" style="-fx-text-fill: #CBD5E1;" text="Preguntas que ya usaste antes." wrapText="true" />
                <HBox spacing="10.0">
                    <children>
                        <TextField fx:id="txtBuscar" promptText="Buscar por enunciado u opción..." styleClass="campo" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="cmbFiltroTipo" prefWidth="260.0" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.63">
            <items>
                <TableView fx:id="tblPreguntas">
                    <columns>
                        <TableColumn fx:id="colEnunciado" prefWidth="300.0" text="Enunciado" />
                        <TableColumn fx:id="colTipo" prefWidth="170.0" text="Tipo" />
                        <TableColumn fx:id="colUsos" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Usada en" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <VBox fx:id="boxDetalle" spacing="8.0" style="-fx-background-color: white;">
                    <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                    </padding>
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0F172A;" text="Detalle de la pregunta" />
                        <Label fx:id="lblDetalleEnunciado" style="-fx-font-size: 13px; -fx-text-fill: #0F172A;" text="Selecciona una pregunta de la lista." wrapText="true" />
                        <Label fx:id="lblDetalleTipo" style="-fx-text-fill: #475569;" wrapText="true" />
                        <Label fx:id="lblDetalleUsos" style="-fx-text-fill: #475569;" wrapText="true" />
                        <Label fx:id="lblTituloOpciones" style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="Opciones:" />
                        <ListView fx:id="lstDetalleOpciones" prefHeight="160.0" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-background-color: #F1F5F9; -fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
            </padding>
            <children>
                <Label fx:id="lblResumen" maxWidth="1.7976931348623157E308" style="-fx-text-fill: #64748B;" text="0 preguntas" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#handleEliminar" style="-fx-background-color: transparent; -fx-text-fill: #DC2626; -fx-cursor: hand;" text="Eliminar del banco" />
                <Button mnemonicParsing="false" onAction="#handleCancelar" text="Cancelar" />
                <Button fx:id="btnAgregar" defaultButton="true" mnemonicParsing="false" onAction="#handleAgregar" styleClass="boton-primario" text="Agregar a la encuesta" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
